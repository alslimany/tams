{
    "mcpServers": {
        "laravel-boost": {
            "command": "php",
            "args": [
                "artisan",
                "boost:mcp"
            ]
        },
        "herd": {
            "command": "php",
            "args": [
                "/Applications/Herd.app/Contents/Resources/herd-mcp.phar"
            ],
            "env": {
                "SITE_PATH": "/Users/abdullah/Herd/tams"
            }
        },
        "laravel-telescope": {
            "command": "php",
            "args": [
                "artisan",
                "telescope-mcp:server"
            ],
            "env": {
                "APP_ENV": "local"
            },
            "cwd": "/Users/abdullah/Herd/tams"
        }
    }
}

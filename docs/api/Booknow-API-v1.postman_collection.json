            },
            "url": {
              "raw": "{{base_url}}/agency/{{tenant}}/api/v1/hotels/select",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "agency",
                "{{tenant}}",
                "api",
                "v1",
                "hotels",
                "select"
              ]

                "agency",
                "{{tenant}}",
                "api",
                "v1",
                "airlines"
              ]
            },
            "description": "Returns all active airlines available to the tenant."
          },
          "response": [
            {
              "name": "200",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"success\": true,\n  \"data\": [\n    { \"airline_code\": \"YI\", \"airline_name\": \"Yemenia Airways\" }\n  ]\n}"

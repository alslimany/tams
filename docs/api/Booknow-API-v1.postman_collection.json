{
  "info": {
    "name": "Booknow API v1",
    "description": "## Booknow REST API v1 \u2014 Mobile Application\n\n**Base URL**: `{{base_url}}/api/v1`  \n**Auth**: Bearer token (set via `{{token}}` variable after Login)  \n**Content-Type**: `application/json`\n\n### Quick Start\n1. Set `base_url` to your tenant domain (e.g. `https://agency.atom.ly`)\n2. Run **Login** \u2014 copy the returned `token` to the `{{token}}` collection variable\n3. All other endpoints use `{{token}}` automatically\n\n### Response Format\n```json\n{ \"success\": true|false, \"message\": \"...\", \"data\": {...} }\n```",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://agency.atom.ly"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "\ud83d\udd10 Auth",
      "description": "Authentication endpoints. Run Login first to get a token.",
      "item": [
        {
          "name": "Login \u2014 Get Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.success && json.data.token) {",
                  "    pm.collectionVariables.set('token', json.data.token);",
                  "    console.log('Token set: ' + json.data.token.substring(0, 20) + '...');",
                  "}",
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Returns token', () => pm.expect(json.data.token).to.be.a('string'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"agent@example.com\",\n  \"password\": \"your-password\",\n  \"device_name\": \"Postman\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/agency/{{tenant}}/api/v1/auth/token",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "agency",
                "{{tenant}}",
                "api",
                "v1",
                "auth",
                "token"
              ]
            },
            "description": "Authenticate and receive a Bearer token. The token is automatically saved to `{{token}}` collection variable."
          },
          "response": [
            {
              "name": "200 \u2014 Success",
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"success\": true,\n  \"message\": \"Token created successfully.\",\n  \"data\": {\n    \"token\": \"1|abcdef123456...\",\n    \"user\": {\n      \"id\": 1,\n      \"name\": \"John Doe\",\n      \"email\": \"agent@example.com\",\n      \"role\": \"agent\",\n      \"is_active\": true,\n      \"initials\": \"JD\",\n      \"last_login_at\": \"2026-05-13T10:00:00.000Z\"\n    }\n  }\n}"
            },
            {
              "name": "403 \u2014 Deactivated",
              "status": "Forbidden",
              "code": 403,
              "body": "{\n  \"success\": false,\n  \"message\": \"Your account has been deactivated.\"\n}"
            }
          ]
        },
        {
          "name": "Get Me \u2014 Current User",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/agency/{{tenant}}/api/v1/auth/me",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "agency",
                "{{tenant}}",
                "api",
                "v1",
                "auth",
                "me"
              ]
            },
            "description": "Returns the currently authenticated user profile."
          },
          "response": [
            {
              "name": "200",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"success\": true,\n  \"data\": {\n    \"id\": 1,\n    \"name\": \"John Doe\",\n    \"email\": \"agent@example.com\",\n    \"role\": \"agent\",\n    \"is_active\": true,\n    \"initials\": \"JD\"\n  }\n}"
            }
          ]
        },
        {
          "name": "List Tokens",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/agency/{{tenant}}/api/v1/auth/tokens",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "agency",
                "{{tenant}}",
                "api",
                "v1",
                "auth",
                "tokens"
              ]
            },
            "description": "List all active API tokens for the current user."
          },
          "response": [
            {
              "name": "200",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"success\": true,\n  \"data\": [\n    { \"id\": 1, \"name\": \"Postman\", \"abilities\": [], \"last_used_at\": \"...\", \"created_at\": \"...\" }\n  ]\n}"
            }
          ]
        },
        {
          "name": "Revoke Token \u2014 Logout",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{base_url}}/agency/{{tenant}}/api/v1/auth/token",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "agency",
                "{{tenant}}",
                "api",
                "v1",
                "auth",
                "token"
              ]
            },
            "description": "Revoke the current Bearer token. After this, the token is invalid."
          },
          "response": [
            {
              "name": "200",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"success\": true,\n  \"message\": \"Token revoked.\",\n  \"data\": null\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "\ud83d\udcda Reference Data",
      "item": [
        {
          "name": "Airports Search",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/agency/{{tenant}}/api/v1/airports/search?q=MJI",
              "host": [

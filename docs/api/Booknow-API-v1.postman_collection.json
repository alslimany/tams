              ],
              "path": [
                "agency",
                "{{tenant}}",
                "api",
                "v1",
                "airports",
                "search"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "MJI",
                  "description": "IATA code (3 chars) or city/country name. Empty returns popular airports."
                }
              ]
            },
            "description": "Search airports by IATA code, city, or country name."
          },
          "response": [
            {
              "name": "200",
              "status": "OK",

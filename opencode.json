{
    "$schema": "https://opencode.ai/config.json",
    "mcp": {
        "laravel-boost": {
            "type": "local",
            "enabled": true,
            "command": [
                "php",
                "artisan",
                "boost:mcp"
            ]
        },
        "herd": {
            "type": "local",
            "enabled": true,
            "command": [
                "php",
                "/Applications/Herd.app/Contents/Resources/herd-mcp.phar"
            ],
            "environment": {
                "SITE_PATH": "/Users/abdullah/Herd/tams"
            }
        },
        "laravel-telescope": {
            "type": "local",
            "enabled": true,
            "command": [
                "php",
                "/Users/abdullah/Herd/tams/artisan",
                "telescope-mcp:server"
            ],
            "environment": {
                "APP_ENV": "local"
            }
        }
    }
}
